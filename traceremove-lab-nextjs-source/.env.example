# Local development template only. Copy this file to .env.local and fill values
# through approved secret storage. Never commit .env.local or production values.
# Leaving values blank keeps the public site available and disables external services.

# Public application URL. Use the production URL only in the hosting environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: required only for accounts, private projects, and persisted data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Supabase aliases are supported during a controlled migration only.
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_ANON_KEY=

# AI analysis: leave empty to use the deterministic demo engine locally.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Paddle: leave every value empty until a separately approved sandbox or production setup.
# Allowed environment values are sandbox and production.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_RESEARCHER=
NEXT_PUBLIC_PADDLE_PRICE_PROFESSIONAL=
NEXT_PUBLIC_PADDLE_PRICE_TEAM=
PADDLE_WEBHOOK_SECRET=
